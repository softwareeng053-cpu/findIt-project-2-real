# Findlt Flask Backend Environment Configuration

# Flask Core
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-campus-secret-key-32chars
JWT_SECRET=change-this-jwt-secret-key-32chars
PORT=5000

# Supabase Credentials (from your Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_BUCKET_NAME=lost-found-images

# Allowed Frontend Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
